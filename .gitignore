# =============================================================================
# Keep source & data separate from runtime state & artifacts.
# Source stays tracked. Runtime state + generated outputs + secrets do not.
# =============================================================================

# -------- Python cache / build --------
__pycache__/
*.py[cod]
$py.class
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.tox/
.nox/
pip-wheel-metadata/
dmypy.json

# -------- IDE / Editor --------
.vscode/
.idea/
*.code-workspace
.github/
.cursorignore
*.swp
*.swo
*~

# -------- CI / repo meta (local-only overrides) --------
.github/local/
copilot-instructions.md

# -------- Virtual environments (not conda env dirs outside repo) --------
# Local temp used by scripts/activate-agent.ps1 to avoid Windows %TEMP% conda lock races
.conda-tmp/
.venv/
venv/
ENV/
env/

# -------- Secrets & environment --------
.env
.env.*
!.env.example
*.pem
*.key
# Commercial / local license files (e.g. Aspose); keep out of VCS
*.lic

# -------- Runtime state --------
# All runtime state lives under .state/ (Agno DB, dialog context, operation logs).
.state/
!.state/.gitkeep

# -------- Runtime DB / sessions (agno SqliteDb) --------
*.db
*.db-shm
*.db-wal

# -------- Test / coverage --------
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# -------- Logs & scratch --------
*.log
logs/
tmp/
temp/
_t/
*.tmp
.cache/
scratch/
local_data/

# -------- Offline tooling (generated audit; see tools-offline/) --------
refine/library_audit/

# -------- Generated / temporary outputs --------
outputs/
!outputs/.gitkeep
static/

# -------- Large redistributables / data dumps --------
*.zip

# -------- OS noise --------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -------- Jupyter --------
.ipynb_checkpoints/

# -------- Local wheel / package mirrors --------
wheelhouse/
wheels/

# -------- Profiling --------
*.prof

# -------- Assets --------
assets/templates/

# -------- Local-only paths --------
TODO.md
MCP_CONTRACT.md
scripts/
tests/
refine/
材料/

# -------- Third-party clones (research deploy experiments) --------
third_party/
Visio_agent/
