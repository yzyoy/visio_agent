# =============================================================================
# Environment template for the agno-based Visio agent.
# Copy to .env and fill in real values. .env itself is gitignored.
# =============================================================================

# --- LLM provider (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_ID=deepseek-chat

# --- Runtime paths ---
# Agno session store; lives under .state/ so it is gitignored by default.
AGNO_SESSIONS_DB=.state/agno_sessions.db

# Read-only Visio template root (canonical asset location).
VISIO_TEMPLATE_DIR=assets/templates

# Dialog / session-context folder (runtime state, gitignored).
VISIO_DIALOG_DIR=.state/dialog
